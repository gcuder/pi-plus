+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { readFile } from "node:fs/promises";
+import { withAnchorSession } from "./anchor-registry";
+import { compPreview } from "./replace";
+import { insertPreview } from "./insert";
+import { replaceWithinPreview } from "./replace-within";
+import { transferPreview } from "./copy-move";
+import { capturePipelines } from "./preview-capture";
+import { bytesForEdit } from "./commit";
+import { joinSeparators } from "./line-endings";
+import { restoreEndings } from "./normalize";
+import { toCwd } from "./paths";
+import { resolveInCwd } from "./fs-write";
+import { batchMemberFor, noteBatchFailure, previewPlannedBatch } from "./batch";
+import { getUndo } from "./replace-undo";
+
+export const PREVIEW_EVENT = "pi-plus:hashline-preview-v1";
+export const REJECT_EVENT = "pi-plus:hashline-reject-v1";
+export interface PreviewFile { path: string; originalContent: string | undefined; proposedContent: string }
+export interface PreviewResult { apiVersion: 1; packageVersion: "5.1.0"; ids: string[]; files: PreviewFile[] }
+
+export async function previewMutation(toolName: string, toolCallId: string, input: unknown, ctx: ExtensionContext): Promise<PreviewResult> {
+  return withAnchorSession(ctx, async () => {
+    const batch = (toolName === "replace" || toolName === "insert")
+      ? await previewPlannedBatch(toolCallId, input, ctx.cwd, ctx.signal) : undefined;
+    if (batch) return { apiVersion: 1, packageVersion: "5.1.0", ...batch };
+    if (toolName === "undo_last_change") {
+      const path = (input as { path?: unknown })?.path;
+      if (typeof path !== "string" || !path) throw new Error("Undo preview requires a path");
+      const { resolved } = await resolveInCwd(path, ctx.cwd);
+      const undo = await getUndo(resolved);
+      if (!undo) throw new Error("No undo history for this file");
+      const originalContent = await readFile(resolved, "utf8").catch((e: NodeJS.ErrnoException) => {
+        if (e.code === "ENOENT") return undefined; throw e;
+      });
+      const expected = undo.bom + (undo.resultSeparators ? joinSeparators(undo.resultContent, undo.resultSeparators) : restoreEndings(undo.resultContent, undo.originalEnding));
+      if (originalContent !== undefined && originalContent !== expected) throw new Error("[E_UNDO_STALE] Undo preview refused: file changed after edit");
+      const proposedContent = undo.bom + (undo.separators ? joinSeparators(undo.content, undo.separators) : restoreEndings(undo.content, undo.originalEnding));
+      return { apiVersion: 1, packageVersion: "5.1.0", ids: [toolCallId], files: [{ path: resolved, originalContent, proposedContent }] };
+    }
+    const { result, pipes, reads } = await capturePipelines(async () => {
+      switch (toolName) {
+        case "replace": return compPreview(input, ctx.cwd, ctx.signal);
+        case "replace_within": return replaceWithinPreview(input, ctx.cwd, ctx.signal);
+        case "insert": return insertPreview(input, ctx.cwd, ctx.signal);
+        case "copy": case "move": return transferPreview(toolName, input, ctx.cwd, ctx.signal);
+        default: throw new Error("Unsupported hashline preview tool");
+      }
+    });
+    if ("error" in result && !result.error.startsWith("No changes made to ")) throw new Error(result.error);
+    if (!pipes.length) throw new Error("Hashline preview produced no file proposal");
+    const files = await Promise.all(pipes.map(async pipe => ({
+      path: (await resolveInCwd(toCwd(pipe.path, ctx.cwd), ctx.cwd)).resolved,
+      originalContent: pipe.bom + joinSeparators(pipe.originalNormalized, pipe.originalSeparators),
+      proposedContent: bytesForEdit(pipe).finalFileBytes,
+    })));
+    // Include immutable dependencies (e.g. copy source) in the read set so an
+    // interior source change during review cannot alter an approved proposal.
+    for (const file of reads) {
+      if (files.some(f => f.path === file.absolutePath)) continue;
+      const originalContent = file.bom + joinSeparators(file.normalized, file.endingSeparators);
+      files.push({ path: file.absolutePath, originalContent, proposedContent: originalContent });
+    }
+    return { apiVersion: 1, packageVersion: "5.1.0", ids: [toolCallId], files };
+  });
+}
+
+// A bus provider keeps previews in the SAME module graph/session registry as the
+// executing hashline extension. No second extension instance or tool overrides.
+export function registerReviewPreview(pi: ExtensionAPI): void {
+  pi.events.on(PREVIEW_EVENT, (request: unknown) => {
+    const r = request as { toolName: string; toolCallId: string; input: unknown; ctx: ExtensionContext; respond: (result: Promise<PreviewResult>) => void };
+    r.respond(previewMutation(r.toolName, r.toolCallId, r.input, r.ctx));
+  });
+  pi.events.on(REJECT_EVENT, (request: unknown) => {
+    const r = request as { toolCallId: string; reason: string };
+    const member = batchMemberFor(r.toolCallId);
+    if (member) noteBatchFailure(member, new Error(r.reason));
+  });
+}
