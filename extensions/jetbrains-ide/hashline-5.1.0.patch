+import { AsyncLocalStorage } from "node:async_hooks";
+import type { PipelineResult } from "./replace";
+import type { NormFile } from "./file-reader";
+
+// Optional full-content observer for the existing read-only UI previews.
+// Outside a preview API request there is no additional byte construction.
+const capture = new AsyncLocalStorage<{ pipes: PipelineResult[]; reads: NormFile[] }>();
+export function capturePipe(pipe: PipelineResult): void { capture.getStore()?.pipes.push(pipe); }
+export function captureNorm(file: NormFile): NormFile { capture.getStore()?.reads.push(file); return file; }
+export async function capturePipelines<T>(fn: () => Promise<T>) {
+  const state = { pipes: [] as PipelineResult[], reads: [] as NormFile[] };
+  const result = await capture.run(state, fn);
+  return { result, ...state };
+}
