+// Read-only counterpart to the planned same-file commit. Reuses exactly the
+// same piece planner, overlap/insert-pair composer and separator mapping.
+export async function previewPlannedBatch(toolCallId: string, input: unknown, cwd: string, signal?: AbortSignal) {
+  const member = batchMemberFor(toolCallId);
+  if (!member) return undefined;
+  const runtime = batches.get(member.batchKey);
+  if (!runtime || runtime.failed) throw new Error("Hashline batch is unavailable or aborted");
+  const file = await readNormFile(member.target, cwd, {
+    accessMode: constants.R_OK, maxLines: MAX_HASH_LINES, noPersist: true, allocation: "shadow", signal,
+  });
+  const base: BatchBase = {
+    content: file.normalized, hashes: file.fileHashes, bom: file.bom,
+    ending: file.originalEnding, separators: file.endingSeparators,
+    identity: file.identity, hadUtf8DecodeErrors: file.hadUtf8DecodeErrors,
+    absolutePath: file.absolutePath, baseLines: splitLines(file.normalized),
+  };
+  const { buildReplaceHEdit } = await import("./replace");
+  const { buildInsertEdit, parseInsertAnchor } = await import("./insert");
+  const { resolveEditTargetWithRequirement } = await import("./edit-common");
+  const pieces: BatchPiece[] = [];
+  const ids: string[] = [];
+  for (const id of runtime.memberIds) {
+    const planned = plan.get(id);
+    if (!planned) throw new Error("Hashline batch member missing");
+    const validated = normReq(id === toolCallId ? input : planned.args);
+    if (planned.kind === "replace") assertReq(validated); else assertInsertReq(validated);
+    const req = validated as any;
+    const target = await resolveEditTargetWithRequirement({
+      ...(planned.kind === "replace" ? { removeFrom: req.remove_from, removeTo: req.remove_to } : { anchor: req.anchor }),
+      providedPath: req.path, cwd,
+    });
+    if ((await resolveInCwd(target, cwd)).resolved !== member.target) throw new Error("Hashline batch target changed");
+    let built: { edit: HEdit; warnings: string[] };
+    let extra: Partial<BatchMemberInput> = {};
+    if (planned.kind === "replace") built = buildReplaceHEdit(req);
+    else {
+      const { ref, warnings } = parseInsertAnchor(req.anchor);
+      const insertion = buildInsertEdit(req, { normalized: base.content, fileHashes: base.hashes } as never, ref, target);
+      built = { edit: resEdit(insertion.editParams), warnings };
+      extra = { direction: req.direction, foldedLines: insertion.anchorLine === undefined ? 0 : 1,
+        stripWarning: { label: "lines", indexOffset: insertion.anchorLine !== undefined && req.direction === "after" ? -1 : 0 },
+        contentSeparators: insertion.contentSeparators };
+    }
+    pieces.push(planBatchPiece({ kind: planned.kind, member: planned, targetPath: member.target,
+      mutationTargetPath: member.target, cwd, signal, hedit: built.edit, extraWarnings: built.warnings, ...extra },
+      base, servedForPath(file.absolutePath), member.target));
+    ids.push(id);
+  }
+  const candidatePieces = pieces.filter(piece => !piece.noop || changesEnding(piece, base.separators));
+  const result = candidatePieces.length ? composeBatchResult(base, mergeInsertPairs(candidatePieces), runtime)
+    : { composed: base.content, finalBytes: base.bom + joinSeparators(base.content, base.separators), originalBytes: base.bom + joinSeparators(base.content, base.separators) };
+  await throwIfStrictInput(pieces.flatMap(piece => piece.warnings));
+  if (candidatePieces.length) assertNotEmpty(base.content, result.composed);
+  assertLineLimit(result.composed, member.target, MAX_HASH_LINES);
+  assertByteLimit(result.finalBytes, member.target);
+  return { ids, files: [{ path: file.absolutePath, originalContent: result.originalBytes, proposedContent: result.finalBytes }] };
